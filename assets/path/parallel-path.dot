  RULE [shape=note, label="P만 원자적\nG는 장 단위 분할 가능\n필수 G 장·실습 생략 금지\n막힌 트랙만 대기", fillcolor="#f8fafc", color="#475569"];

  COMPLETE [label="◇ 4트랙 완료\nP01~P24 + 필수 가이드 전체 커버리지\nL04~L13 + P0/P1 해결", shape=diamond,
