      <TR><TD BGCOLOR="#f8fafc" COLSPAN="4"><B>동기화 관계 범례 — 실제 제공/소비 노드 직접 연결</B></TD></TR>
      <TR><TD BGCOLOR="#fce7f3"><FONT COLOR="#9d174d"><B>S1 · CPP-G02</B></FONT></TD><TD>→</TD><TD BGCOLOR="#fce7f3"><FONT COLOR="#9d174d"><B>P09</B></FONT></TD><TD>Algorithms 01~10</TD></TR>
      <TR><TD BGCOLOR="#fef3c7"><FONT COLOR="#92400e"><B>S2 · CPP-G05</B></FONT></TD><TD>→</TD><TD BGCOLOR="#fef3c7"><FONT COLOR="#92400e"><B>WEB-G07</B></FONT></TD><TD>Networks 01~11</TD></TR>
      <TR><TD BGCOLOR="#cffafe"><FONT COLOR="#155e75"><B>S3 · WEB-G04</B></FONT></TD><TD>→</TD><TD BGCOLOR="#cffafe"><FONT COLOR="#155e75"><B>P22</B></FONT></TD><TD>Web Apps 07~08</TD></TR>
      <TR><TD BGCOLOR="#ecfccb"><FONT COLOR="#3f6212"><B>S4 · WEB-G01·06·07</B></FONT></TD><TD>→</TD><TD BGCOLOR="#ecfccb"><FONT COLOR="#3f6212"><B>P24</B></FONT></TD><TD>Infra·DB·Networks 12</TD></TR>
    </TABLE>
  >];
  SYNC -> G00 [style=dashed, color="#94a3b8", constraint=false];

  MERGE [label="◇ 4트랙 완료\nP01~P24 + 필수 가이드 전체 커버리지", shape=diamond,
