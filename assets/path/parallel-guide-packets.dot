digraph ParallelTrackDetail {
  graph [rankdir=TB, newrank=true, bgcolor="white", pad="0.35", nodesep="0.34", ranksep="0.45",
    fontname="Noto Sans CJK KR", fontsize=21,
    label="4트랙 상세 — 필수 가이드 구간과 프로젝트의 선형 순서", labelloc=t, splines=polyline];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=10,
    margin="0.12,0.07", color="#64748b", fillcolor="#f8fafc"];
  edge [fontname="Noto Sans CJK KR", fontsize=8, color="#64748b", arrowsize=0.64, penwidth=1.05];

  G00 [label="G00 guide-git 01~06\n네 트랙 공통 완료", fillcolor="#e2e8f0", color="#475569", penwidth=1.8];

  subgraph cluster_c {
    label="C TRACK"; color="#2563eb"; penwidth=2; style="rounded";
    C1 [label="C-G01\nguide-c 01~04·06"];
    C2 [label="P01", fillcolor="#dbeafe", penwidth=2];
    C3 [label="C-G02\nUnix 01~03"];
    C4 [label="P02", fillcolor="#dbeafe", penwidth=2];
    C5 [label="C-G03\nC 05"];
    C6 [label="P03", fillcolor="#dbeafe", penwidth=2];
    C7 [label="C-S01\nCPP-G02 동기화", fillcolor="#fef3c7"];
    C8 [label="P09", fillcolor="#dbeafe", penwidth=2];
    C9 [label="C-G04\nC 08 + Unix 04"];
    C10 [label="P04", fillcolor="#dbeafe", penwidth=2];
    C11 [label="C-G05\nC 07·09 + Unix 05~06"];
    C12 [label="P05", fillcolor="#dbeafe", penwidth=2];
    C13 [label="C-G06\nC 10 + OS 01~06"];
    C14 [label="P06", fillcolor="#dbeafe", penwidth=2];
    C15 [label="C-G07\nUnix 07~09 + OS 07~10\nG01·G02·G04 폐쇄"];
    C16 [label="C 완료", shape=octagon, fillcolor="#bfdbfe"];
    C1 -> C2 -> C3 -> C4 -> C5 -> C6 -> C7 -> C8 -> C9 -> C10 -> C11 -> C12 -> C13 -> C14 -> C15 -> C16;
  }

  subgraph cluster_cpp {
    label="C++ TRACK"; color="#7c3aed"; penwidth=2; style="rounded";
    X1 [label="CPP-G01\nC++ 01~05"];
    X2 [label="P07", fillcolor="#ede9fe", penwidth=2];
    X3 [label="CPP-G02\nAlgorithms 01~10"];
    X4 [label="CPP-G03\nC++ 06~07 + Algorithms 11"];
    X5 [label="P08", fillcolor="#ede9fe", penwidth=2];
    X6 [label="CPP-G04\nAlgorithms 12~16 + Architecture 01~10\nG05·G06 폐쇄"];
    X7 [label="P10", fillcolor="#ede9fe", penwidth=2];
    X8 [label="CPP-G05\nC++ 08~09 + Networks 01~11\nG03 폐쇄"];
    X9 [label="P11", fillcolor="#ede9fe", penwidth=2];
    X10 [label="C++ 완료", shape=octagon, fillcolor="#ddd6fe"];
    X1 -> X2 -> X3 -> X4 -> X5 -> X6 -> X7 -> X8 -> X9 -> X10;
  }

  subgraph cluster_web {
    label="WEB TRACK"; color="#059669"; penwidth=2; style="rounded";
    W1 [label="WEB-G01\nWeb Infra 01~07\nG08 폐쇄"];
    W2 [label="P12", fillcolor="#d1fae5", penwidth=2];
    W3 [label="WEB-G02\nWeb Apps 00~06"];
    W4 [label="P13", fillcolor="#d1fae5", penwidth=2];
    W5 [label="WEB-G03\nFrontend 00~04\nG10 폐쇄"];
    W6 [label="P14", fillcolor="#d1fae5", penwidth=2];
    W7 [label="WEB-G04\nWeb Apps 07~08"];
    W8 [label="WEB-G05\nWeb Apps 09\nG09 폐쇄"];
    W9 [label="WEB-G06\nDatabase 01~12\nG11 폐쇄"];
    W10 [label="WEB-S01\nCPP-G05 동기화", fillcolor="#fef3c7"];
    W11 [label="WEB-G07\nNetworks 12\nG07 폐쇄"];
    W12 [label="P15", fillcolor="#d1fae5", penwidth=2];
    W13 [label="WEB 완료", shape=octagon, fillcolor="#a7f3d0"];
    W1 -> W2 -> W3 -> W4 -> W5 -> W6 -> W7 -> W8 -> W9 -> W10 -> W11 -> W12 -> W13;
  }

  subgraph cluster_sb {
    label="SPORTSBOOK TRACK"; color="#c2410c"; penwidth=2; style="rounded";
    S1 [label="SB-G01\nJava 01~08\nG12 폐쇄"];
    S2 [label="P16", fillcolor="#ffedd5", penwidth=2];
    S3 [label="SB-G02\nSpring Boot 01~10\nG13 폐쇄"];
    S4 [label="P17", fillcolor="#ffedd5", penwidth=2];
    S5 [label="P18", fillcolor="#ffedd5", penwidth=2];
    S6 [label="P19", fillcolor="#ffedd5", penwidth=2];
    S7 [label="SB-G03\nDistributed 01~07"];
    S8 [label="P20", fillcolor="#ffedd5", penwidth=2];
    S9 [label="P21", fillcolor="#ffedd5", penwidth=2];
    S10 [label="SB-S01\nWEB-G04 동기화", fillcolor="#fef3c7"];
    S11 [label="P22", fillcolor="#ffedd5", penwidth=2];
    S12 [label="P23", fillcolor="#ffedd5", penwidth=2];
    S13 [label="SB-G04\nDistributed 08~10\nG14 폐쇄"];
    S14 [label="SB-G05\nShell 01~08\n조건 충족 필수"];
    S15 [label="SB-S02\nWEB-G01·06·07 동기화", fillcolor="#fef3c7"];
    S16 [label="P24", fillcolor="#ffedd5", penwidth=2];
    S17 [label="SPORTSBOOK 완료", shape=octagon, fillcolor="#fed7aa"];
    S1 -> S2 -> S3 -> S4 -> S5 -> S6 -> S7 -> S8 -> S9 -> S10 -> S11 -> S12 -> S13 -> S14 -> S15 -> S16 -> S17;
  }

  G00 -> C1 [color="#2563eb"];
  G00 -> X1 [color="#7c3aed"];
  G00 -> W1 [color="#059669"];
  G00 -> S1 [color="#c2410c"];

  C1 -> X1 [style=dashed, label="기초 재사용", color="#94a3b8", constraint=false];
  W2 -> S2 [style=dashed, label="과거 경험 재사용", color="#94a3b8", constraint=false];

  SYNC [shape=plain, label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#dc2626">
      <TR><TD BGCOLOR="#fee2e2" COLSPAN="2"><B>하드 동기화</B></TD></TR>
      <TR><TD ALIGN="LEFT">CPP-G02 → C-S01</TD><TD ALIGN="LEFT">Algorithms 01~10</TD></TR>
      <TR><TD ALIGN="LEFT">CPP-G05 → WEB-S01</TD><TD ALIGN="LEFT">Networks 01~11</TD></TR>
      <TR><TD ALIGN="LEFT">WEB-G04 → SB-S01</TD><TD ALIGN="LEFT">Web Apps 07~08</TD></TR>
      <TR><TD ALIGN="LEFT">WEB-G01·06·07 → SB-S02</TD><TD ALIGN="LEFT">Infra·DB·Networks 12</TD></TR>
    </TABLE>
  >];
  G00 -> SYNC [style=dashed, color="#dc2626", constraint=false];

  MERGE [label="◇ 4트랙 완료\nP01~P24 + 필수 가이드 전체 커버리지", shape=diamond,
    fillcolor="#fde68a", color="#b45309", penwidth=2];
  C16 -> MERGE;
  X10 -> MERGE;
  W13 -> MERGE;
  S17 -> MERGE;
}
